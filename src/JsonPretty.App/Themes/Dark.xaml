<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 앱 고유 색 (다크). 키 이름은 Light.xaml 과 같아야 한다. -->
    <SolidColorBrush x:Key="Brush.Bar" Color="#202020" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Splitter" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Brush.SubtleText" Color="#A8A8A8" />
    <SolidColorBrush x:Key="Brush.FaintText" Color="#707070" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF7B72" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#56D364" />
    <SolidColorBrush x:Key="Brush.BannerBackground" Color="#3A3214" />
    <SolidColorBrush x:Key="Brush.BannerBorder" Color="#6B5B1E" />

    <SolidColorBrush x:Key="Brush.EditorBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Brush.OutputBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.EditorForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Brush.LineNumbers" Color="#6E7681" />

    <Color x:Key="Color.Key">#9CDCFE</Color>
    <Color x:Key="Color.String">#CE9178</Color>
    <Color x:Key="Color.Number">#B5CEA8</Color>
    <Color x:Key="Color.Literal">#569CD6</Color>
    <Color x:Key="Color.Punctuation">#D4D4D4</Color>
    <SolidColorBrush x:Key="Brush.Key" Color="{StaticResource Color.Key}" />
    <SolidColorBrush x:Key="Brush.String" Color="{StaticResource Color.String}" />
    <SolidColorBrush x:Key="Brush.Number" Color="{StaticResource Color.Number}" />
    <SolidColorBrush x:Key="Brush.Literal" Color="{StaticResource Color.Literal}" />
</ResourceDictionary>
