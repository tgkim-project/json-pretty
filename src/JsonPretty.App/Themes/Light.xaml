<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 앱 고유 색 (라이트). 컨트롤 기본 모양은 WPF Fluent 테마가 담당한다. -->
    <SolidColorBrush x:Key="Brush.Bar" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DDDDDD" />
    <SolidColorBrush x:Key="Brush.Splitter" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Brush.SubtleText" Color="#666666" />
    <SolidColorBrush x:Key="Brush.FaintText" Color="#AAAAAA" />
    <SolidColorBrush x:Key="Brush.Text" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Error" Color="#C42B1C" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#0B7A3E" />
    <SolidColorBrush x:Key="Brush.BannerBackground" Color="#FFF8E1" />
    <SolidColorBrush x:Key="Brush.BannerBorder" Color="#F0D98C" />

    <SolidColorBrush x:Key="Brush.EditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.OutputBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.EditorForeground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.LineNumbers" Color="#999999" />

    <!-- JSON 요소 색 (에디터 구문 강조와 트리에서 공통 사용) -->
    <Color x:Key="Color.Key">#871094</Color>
    <Color x:Key="Color.String">#067D17</Color>
    <Color x:Key="Color.Number">#C42B1C</Color>
    <Color x:Key="Color.Literal">#0033B3</Color>
    <Color x:Key="Color.Punctuation">#1F1F1F</Color>
    <SolidColorBrush x:Key="Brush.Key" Color="{StaticResource Color.Key}" />
    <SolidColorBrush x:Key="Brush.String" Color="{StaticResource Color.String}" />
    <SolidColorBrush x:Key="Brush.Number" Color="{StaticResource Color.Number}" />
    <SolidColorBrush x:Key="Brush.Literal" Color="{StaticResource Color.Literal}" />
</ResourceDictionary>
