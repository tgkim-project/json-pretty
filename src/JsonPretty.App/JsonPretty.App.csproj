<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- WPF0001: .NET 9 Fluent 테마(ThemeMode)는 실험 기능 경고 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JsonPretty.App</RootNamespace>
    <AssemblyName>JsonPretty</AssemblyName>
    <Product>JSON Pretty</Product>
    <!-- 배포 버전. release.ps1 -Version 으로 바꾸면 GitHub Release 태그(v버전)에도 쓰인다 -->
    <Version>1.1.0</Version>
    <!-- exe 파일 아이콘 (탐색기, 바로 가기). 다시 만들려면 tools\make-icon.ps1 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 창 제목 표시줄·작업 표시줄 아이콘 -->
    <Resource Include="Assets\app.ico" />
    <None Remove="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonPretty.Core\JsonPretty.Core.csproj" />
  </ItemGroup>

</Project>
