<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- WPF0001: .NET 9 Fluent 테마(ThemeMode)는 실험 기능 경고 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JsonPretty.App</RootNamespace>
    <AssemblyName>JsonPretty</AssemblyName>
    <Product>JSON Pretty</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonPretty.Core\JsonPretty.Core.csproj" />
  </ItemGroup>

</Project>
