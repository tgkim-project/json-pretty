<Window x:Class="JsonPretty.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:vm="clr-namespace:JsonPretty.App.ViewModels"
        xmlns:l="clr-namespace:JsonPretty.App.Localization"
        Title="{Binding WindowTitle}" Icon="Assets/app.ico" Width="1200" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Background="{DynamicResource Brush.EditorBackground}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Malgun Gothic" FontSize="13">

    <!-- DataContext(MainViewModel)는 저장된 설정을 넘겨야 해서 코드 비하인드에서 만든다. -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 버튼 간격만 주고 모양은 테마(Fluent) 기본 스타일을 그대로 쓴다 -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveFileCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyCommand}" />
        <KeyBinding Modifiers="Ctrl+Alt" Key="C" Command="{Binding CopyMinifiedCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Enter" Command="{Binding FormatCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="V" Command="{Binding PasteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- 툴바 -->
        <!-- 창이 좁으면 기능 묶음 단위로 다음 줄로 넘어간다.
             묶음마다 위아래 여백을 줘서 두 줄이 되어도 겹쳐 보이지 않게 하고,
             줄 끝에 구분선만 남는 일이 없도록 구분선 대신 묶음 사이 간격으로 나눈다. -->
        <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource Brush.Bar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style x:Key="ToolGroup" TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="Margin" Value="0,4,14,4" />
                    </Style>
                    <!-- Fluent 체크박스는 최소 너비가 커서 간격이 벌어지므로 줄인다 -->
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0,0,14,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </WrapPanel.Resources>

                <StackPanel Style="{StaticResource ToolGroup}">
                    <Button Content="{l:Tr Open}" Command="{Binding OpenFileCommand}" ToolTip="{l:Tr Open_Tip}" />
                    <Button Content="{l:Tr Save}" Command="{Binding SaveFileCommand}" ToolTip="{l:Tr Save_Tip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource ToolGroup}">
                    <Button Content="{l:Tr Paste}" Command="{Binding PasteCommand}" ToolTip="{l:Tr Paste_Tip}" />
                    <Button Content="{l:Tr Clear}" Command="{Binding ClearCommand}" />
                </StackPanel>
                <StackPanel Style="{StaticResource ToolGroup}">
                    <Button Content="{l:Tr Format}" Command="{Binding FormatCommand}" FontWeight="SemiBold" ToolTip="{l:Tr Format_Tip}" />
                    <Button Content="{l:Tr Minify}" Command="{Binding MinifyCommand}" ToolTip="{l:Tr Minify_Tip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource ToolGroup}">
                    <Button Content="{l:Tr Copy}" Command="{Binding CopyCommand}" FontWeight="SemiBold" ToolTip="{l:Tr Copy_Tip}" />
                    <Button Content="{l:Tr CopyMinified}" Command="{Binding CopyMinifiedCommand}" ToolTip="{l:Tr CopyMinified_Tip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource ToolGroup}">
                    <TextBlock Text="{l:Tr Indent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding IndentChoices}" SelectedItem="{Binding SelectedIndent}" DisplayMemberPath="Label"
                              Width="118" VerticalContentAlignment="Center" />
                    <CheckBox Content="{l:Tr SortKeys}" IsChecked="{Binding SortKeys}" ToolTip="{l:Tr SortKeys_Tip}" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Style="{StaticResource ToolGroup}">
                    <Button Content="{l:Tr Settings}" Command="{Binding OpenSettingsCommand}" ToolTip="{l:Tr Settings_Tip}" Margin="0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 클립보드 JSON 감지 안내 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.BannerBackground}" BorderBrush="{DynamicResource Brush.BannerBorder}" BorderThickness="0,0,0,1" Padding="10,6"
                Visibility="{Binding HasClipboardSuggestion, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Tr Banner_Paste}" Command="{Binding AcceptClipboardSuggestionCommand}" FontWeight="SemiBold" />
                    <Button Content="{l:Tr Banner_Ignore}" Command="{Binding DismissClipboardSuggestionCommand}" />
                    <Button Content="{l:Tr Banner_Never}" Command="{Binding DisableClipboardDetectionCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding ClipboardSuggestionInfo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 상태바 -->
        <Border DockPanel.Dock="Bottom" Padding="10,5" Background="{DynamicResource Brush.Bar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ToastText}" Foreground="{DynamicResource Brush.Toast}" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           MouseLeftButtonUp="StatusLabel_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- 입력 / 출력 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InputColumn" Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="OutputColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Margin="8,6" Foreground="{DynamicResource Brush.SubtleText}">
                <Run Text="{l:Tr Input_Header}" />
                <Run Text="{l:Tr Input_Hint}" Foreground="{DynamicResource Brush.FaintText}" />
            </TextBlock>
            <DockPanel Grid.Column="2" Margin="8,6">
                <TextBlock DockPanel.Dock="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTreeTabSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Hyperlink Click="FoldAll_Click"><Run Text="{l:Tr FoldAll}" /></Hyperlink>
                    <Run Text="  ·  " Foreground="{DynamicResource Brush.FaintText}" />
                    <Hyperlink Click="UnfoldAll_Click"><Run Text="{l:Tr UnfoldAll}" /></Hyperlink>
                </TextBlock>
                <TextBlock Text="{l:Tr Output_Header}" Foreground="{DynamicResource Brush.SubtleText}" />
            </DockPanel>

            <avalon:TextEditor x:Name="InputEditor" Grid.Row="1" Grid.Column="0"
                               FontFamily="Consolas, Malgun Gothic" FontSize="14"
                               ShowLineNumbers="True" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               Background="{DynamicResource Brush.EditorBackground}" Foreground="{DynamicResource Brush.EditorForeground}"
                               LineNumbersForeground="{DynamicResource Brush.LineNumbers}"
                               BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />

            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Splitter}" />

            <TabControl x:Name="OutputTabs" Grid.Row="1" Grid.Column="2" TabStripPlacement="Bottom"
                        Padding="0" BorderThickness="0,1,0,0" SelectionChanged="OutputTabs_SelectionChanged">
            <TabItem Header="{l:Tr Tab_Text}">
            <avalon:TextEditor x:Name="OutputEditor"
                               FontFamily="Consolas, Malgun Gothic" FontSize="14"
                               ShowLineNumbers="True" IsReadOnly="True" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               Background="{DynamicResource Brush.OutputBackground}" Foreground="{DynamicResource Brush.EditorForeground}"
                               LineNumbersForeground="{DynamicResource Brush.LineNumbers}" BorderThickness="0">
                <avalon:TextEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr Menu_CopySelection}" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="{l:Tr Menu_CopyAll}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+Shift+C" />
                        <MenuItem Header="{l:Tr Menu_CopyMinified}" Command="{Binding CopyMinifiedCommand}" InputGestureText="Ctrl+Alt+C" />
                        <Separator />
                        <MenuItem Header="{l:Tr FoldAll}" Click="FoldAll_Click" />
                        <MenuItem Header="{l:Tr UnfoldAll}" Click="UnfoldAll_Click" />
                    </ContextMenu>
                </avalon:TextEditor.ContextMenu>
            </avalon:TextEditor>
            </TabItem>

            <TabItem Header="{l:Tr Tab_Tree}">
                <DockPanel>
                    <!-- 선택한 노드의 경로와 복사 버튼 -->
                    <Border DockPanel.Dock="Bottom" Padding="6" Background="{DynamicResource Brush.Bar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{l:Tr CopyPath}" Command="{Binding CopyTreePathCommand}" />
                                <Button Content="{l:Tr CopyValue}" Command="{Binding CopyTreeValueCommand}" Margin="0" />
                            </StackPanel>
                            <TextBox Text="{Binding SelectedTreeNode.Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" FontFamily="Consolas, Malgun Gothic"
                                     ToolTip="{l:Tr Path_Tip}" />
                        </DockPanel>
                    </Border>

                    <TreeView x:Name="JsonTree" ItemsSource="{Binding Tree.Roots}" BorderThickness="0" Background="{DynamicResource Brush.OutputBackground}"
                              FontFamily="Consolas, Malgun Gothic" FontSize="14"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="JsonTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="JsonTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:JsonTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Key}" />
                                    <TextBlock Text=": " Foreground="{DynamicResource Brush.SubtleText}" />
                                    <TextBlock x:Name="ValueText" Text="{Binding Preview}" Foreground="{DynamicResource Brush.Text}" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Object">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Array">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.SubtleText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="String">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.String}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Number">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.Number}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.Literal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Null">
                                        <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brush.Literal}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:Tr CopyPath}" Command="{Binding CopyTreePathCommand}" />
                                <MenuItem Header="{l:Tr CopyValue}" Command="{Binding CopyTreeValueCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
